# Cấu hình trang Admin của server-panel (http://127.0.0.1:9199/admin).
# Chép file này thành `.env.admin` rồi điền giá trị. `.env.admin` không lên git.

# Địa chỉ dự án Supabase — Dashboard → Project Settings → API → Project URL.
SUPABASE_URL=https://xxxx.supabase.co

# Khoá service_role — Dashboard → Project Settings → API → service_role (secret).
# Toàn quyền, bỏ qua RLS: chỉ backend của panel dùng, trình duyệt không bao giờ
# nhận được khoá này. Đừng dán vào chat / commit / gửi cho ai.
SUPABASE_SERVICE_ROLE_KEY=

# (Tuỳ chọn) Số phút "Cho phép ghi" tự tắt. Mặc định 15.
ADMIN_WRITE_MINUTES=15
